{
  "name": "necotur-server",
  "version": "1.0.0",
  "description": "Backend Necochea Turismo — auth y sesiones",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "build:web": "npm run build --prefix ../proyecto-migrado-react",
